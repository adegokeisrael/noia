# ─────────────────────────────────────────────────────────────────────────────
# NOIA Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Backend ──────────────────────────────────────────────────────────────
# Options: "local" (llama.cpp) | "openai" (OpenAI-compatible REST API)
LLM_BACKEND=local

# Path to the GGUF model file (used when LLM_BACKEND=local)
LOCAL_MODEL_PATH=models/mistral-7b-instruct-v0.3.Q4_K_M.gguf

# OpenAI-compatible API settings (used when LLM_BACKEND=openai)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Use a telecom-fine-tuned model if available:
# EMBEDDING_MODEL=aitr-team/telecom-minilm-v1

# ── Reranker model ────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=noia_knowledge_base

# ── BM25 Index ────────────────────────────────────────────────────────────────
BM25_INDEX_PATH=data/bm25_index.pkl

# ── Retrieval parameters ──────────────────────────────────────────────────────
# α blending coefficient: 1.0 = pure dense, 0.0 = pure sparse
HYBRID_ALPHA=0.55
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
GROUNDEDNESS_THRESHOLD=0.78

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-to-a-long-random-secret
API_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Corpus directory ─────────────────────────────────────────────────────────
CORPUS_DIR=data/corpus

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json        # "json" | "console"

# ── Audit database ────────────────────────────────────────────────────────────
AUDIT_DB_PATH=data/audit.db
